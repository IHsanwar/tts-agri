# ──────────────────────────────────────────────
# Frontend Environment Variables (Vite)
# Copy this file to ".env" and adjust values as needed.
# Variables MUST be prefixed with VITE_ to be exposed to the browser.
# ──────────────────────────────────────────────

# Leave this EMPTY for both development and production.
#
# Session auth is cookie-based (httpOnly session cookie + JS-readable CSRF
# cookie), so the browser must talk to the API on the SAME origin as the page:
#   - dev:        Vite proxies /api/* to VITE_API_PROXY_TARGET
#   - production: vercel.json rewrites /api/* to the backend
#
# Pointing this at https://tts-api.ihsanwardhana.web.id makes every call
# cross-origin, and the browser then silently drops the Set-Cookie response.
# Login appears to succeed, then /api/auth/me answers
# "Sesi guru tidak ditemukan." The client detects that case and falls back to
# same-origin /api, but leaving this empty is the correct configuration.
VITE_API_BASE_URL=

# Vite dev-server proxy target for "/api/*" requests.
# Only used during local development (npm run dev).
VITE_API_PROXY_TARGET=https://tts-api.ihsanwardhana.web.id
