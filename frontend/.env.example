# ──────────────────────────────────────────────
# Frontend Environment Variables (Vite)
# Copy this file to ".env" and adjust values as needed.
# Variables MUST be prefixed with VITE_ to be exposed to the browser.
# ──────────────────────────────────────────────

# When set, all API requests go directly to this URL (e.g. https://tts-api.ihsanwardhana.web.id).
# When empty (default), requests are sent to "/api/*" which is proxied by Vite (dev)
# or rewritten by vercel.json (production).
VITE_API_BASE_URL=

# Vite dev-server proxy target for "/api/*" requests.
# Only used during local development (npm run dev).
VITE_API_PROXY_TARGET=https://tts-api.ihsanwardhana.web.id
