# TTS Arena Environment Variables

# Database
TTS_DATABASE_URL=sqlite+aiosqlite:///./data/tts.sqlite

# Security
TTS_APP_ORIGIN=http://localhost:5173
TTS_COOKIE_SECURE=false
TTS_INVITE_CODE=sekolah-merdeka-2026

# Session TTL
TTS_SESSION_TTL_HOURS_TEACHER=168
TTS_SESSION_TTL_HOURS_GROUP=12

# Game & Group Settings
TTS_GROUP_PIN_DIGITS=6
TTS_COMPETITION_CODE_LEN=6
TTS_GROUP_CODE_LEN=4

# Rate limits
TTS_RATE_JOIN_PER_MINUTE_IP=8
TTS_RATE_JOIN_PER_MINUTE_GROUP=12
TTS_RATE_REGISTER_PER_MINUTE_IP=5
TTS_RATE_EVENTS_PER_MINUTE_SESSION=60
TTS_RATE_WRONG_ATTEMPTS_PER_MINUTE_SESSION=10

# CORS (optional comma-separated list)
TTS_CORS_ORIGINS=
