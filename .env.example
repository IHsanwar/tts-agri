# TTS Arena Environment Variables

# ──────────────────────────────────────────────
# Backend (FastAPI) Settings
# ──────────────────────────────────────────────

# MySQL Database Configuration
TTS_DB_USER=root
TTS_DB_NAME=ttsdulu
TTS_DB_PASSWORD=changeme
TTS_DB_HOST=localhost
TTS_DB_PORT=3306

# The frontend origin — used for CSRF/origin checks.
# Local dev: http://localhost:5173
# Production: https://your-frontend-domain.vercel.app
TTS_APP_ORIGIN=http://localhost:5173

# Public base URL of the frontend (used in links, redirects, etc.)
TTS_APP_URL=http://localhost:5173

# Set to true when serving over HTTPS in production
TTS_COOKIE_SECURE=false

TTS_INVITE_CODE=sekolah-merdeka-2026

# Debug mode — set true to show detailed error messages in API responses (false in production!)
APP_DEBUG=false

# Session TTL
TTS_SESSION_TTL_HOURS_TEACHER=168
TTS_SESSION_TTL_HOURS_GROUP=12

# Game & Group Settings
TTS_GROUP_PIN_DIGITS=6
TTS_COMPETITION_CODE_LEN=6
TTS_GROUP_CODE_LEN=4

# Rate limits
TTS_RATE_JOIN_PER_MINUTE_IP=8
TTS_RATE_JOIN_PER_MINUTE_GROUP=12
TTS_RATE_REGISTER_PER_MINUTE_IP=5
TTS_RATE_EVENTS_PER_MINUTE_SESSION=60
TTS_RATE_WRONG_ATTEMPTS_PER_MINUTE_SESSION=10

# CORS (optional comma-separated list)
# In production, set to the frontend domain(s), e.g. https://tts.ihsanwardhana.web.id
TTS_CORS_ORIGINS=
